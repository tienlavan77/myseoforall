{
  "name": "myseoforall/wordpress-plugin",
  "description": "My SEO For All - SEO Assistant for WordPress and WooCommerce",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "MySeoForAll\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MySeoForAll\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
